VITE_DEEPSEEK_API_KEY=your-api-key-here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_MODEL=deepseek-flash
VITE_AMAP_KEY=your-amap-js-api-key
VITE_AMAP_SECURITY_CODE=your-amap-security-js-code

# Server-only publishing authorization. Generate a random value of at least 24 characters.
# Required by Docker / NODE_ENV=production. Never prefix this with VITE_.
PUBLISH_ADMIN_TOKEN=
# Local standalone server defaults; Compose sets its own internal port and storage path.
HOST=127.0.0.1
PORT=3001
# DATA_DIR=./data
